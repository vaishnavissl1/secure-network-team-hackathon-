log_format shield_access escape=json '{"time":"$time_iso8601","request_id":"$request_id",'
    '"method":"$request_method","uri":"$uri","status":$status,'
    '"upstream_status":"$upstream_status","limit_req_status":"$limit_req_status",'
    '"user_agent":"$http_user_agent"}';

server {
    listen ${PORT};
    server_name ${SERVER_NAME};
    access_log /var/log/modsecurity/audit/access.log shield_access;
    add_header X-Request-ID $request_id always;
    return 301 https://shield.local:8443$request_uri;
}

server {
    listen ${SSL_PORT} ssl;
    server_name ${SERVER_NAME};
    access_log /var/log/modsecurity/audit/access.log shield_access;
    add_header X-Request-ID $request_id always;
    modsecurity_transaction_id $request_id;
    proxy_hide_header X-Request-ID;
    limit_req zone=shield_login burst=5 nodelay;
    limit_req_status 429;
    ssl_certificate /etc/nginx/conf/server.crt;
    ssl_certificate_key /etc/nginx/conf/server.key;
    ssl_protocols ${SSL_PROTOCOLS};

    location = /healthz {
        default_type text/plain;
        return 200 "OK\n";
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass ${BACKEND};
    }
}
