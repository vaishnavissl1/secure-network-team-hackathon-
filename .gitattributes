# Force LF line endings so shell/python/config files work on Person A's Linux VM
*.sh   text eol=lf
*.py   text eol=lf
*.conf text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.md   text eol=lf
# Keep binaries untouched
*.crt  binary
*.key  binary
*.png  binary
*.jpg  binary
*.ico  binary
